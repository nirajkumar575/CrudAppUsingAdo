@model CrudAppUsingAdo.Models.Employee

@{
	ViewData["Title"] = "Employee Details";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card border-0 shadow-lg">
				<div class="card-header bg-primary text-white text-center">
					<h3><i class="bi bi-person-badge"></i> Employee Details</h3>
				</div>
				<div class="card-body">
					<div class="p-3">
						<dl class="row">
							<dt class="col-sm-4 text-secondary"><i class="bi bi-hash"></i> Employee ID:</dt>
							<dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.id)</dd>

							<dt class="col-sm-4 text-secondary"><i class="bi bi-person"></i> Name:</dt>
							<dd class="col-sm-8">@Html.DisplayFor(model => model.name)</dd>

							<dt class="col-sm-4 text-secondary"><i class="bi bi-geo-alt"></i> Address:</dt>
							<dd class="col-sm-8">@Html.DisplayFor(model => model.address)</dd>

							<dt class="col-sm-4 text-secondary"><i class="bi bi-cash"></i> Salary:</dt>
							<dd class="col-sm-8">@Html.DisplayFor(model => model.salary)</dd>

							<dt class="col-sm-4 text-secondary"><i class="bi bi-calendar"></i> Joining Date:</dt>
							<dd class="col-sm-8">@Html.DisplayFor(model => model.joining_date)</dd>

							<dt class="col-sm-4 text-secondary"><i class="bi bi-gender-ambiguous"></i> Gender:</dt>
							<dd class="col-sm-8">@Html.DisplayFor(model => model.gender)</dd>

							<dt class="col-sm-4 text-secondary"><i class="bi bi-hourglass"></i> Age:</dt>
							<dd class="col-sm-8">@Html.DisplayFor(model => model.age)</dd>
						</dl>
					</div>
					<div class="d-flex justify-content-between">
						<a href="@Url.Action("Edit", "Dashboard", new { id = Model.id })" class="btn btn-warning">
							<i class="bi bi-pencil-square"></i> Edit
						</a>
						<a asp-action="Index" class="btn btn-secondary">
							<i class="bi bi-arrow-left"></i> Back to List
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<style>
	.card {
		border-radius: 12px;
	}

	.card-header {
		font-size: 1.5rem;
		font-weight: bold;
	}

	.text-secondary {
		font-weight: bold;
	}

	.btn i {
		margin-right: 5px;
	}

	.btn-warning:hover {
		background-color: #d39e00;
	}

	.btn-secondary:hover {
		background-color: #5a6268;
	}

</style>